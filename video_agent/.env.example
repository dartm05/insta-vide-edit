# API Configuration
ANTHROPIC_API_KEY=your_api_key_here

# Model Configuration
CLAUDE_MODEL=claude-sonnet-4-5-20250929
CLAUDE_MAX_TOKENS=4096
CLAUDE_TEMPERATURE=0.7

# Frame Extraction Settings
FRAME_SAMPLE_RATE=1
MAX_FRAME_DIMENSION=1024
FRAME_QUALITY=85

# Scene Detection
SCENE_THRESHOLD=27.0
MIN_SCENE_LENGTH=0.5

# Audio Settings
WHISPER_MODEL=base
SILENCE_THRESHOLD_DB=-40
MIN_SILENCE_DURATION=500

# Processing Directories
TEMP_DIR=./temp
OUTPUT_DIR=./output
CACHE_DIR=./cache

# Performance
MAX_VIDEO_MEMORY_MB=2048
ENABLE_CACHING=true
PARALLEL_PROCESSING=true

# Logging
LOG_LEVEL=INFO
# LOG_FILE=./logs/video_agent.log

# Caption Settings
CAPTION_MAX_WORDS=7
CAPTION_FONT_SIZE=60
CAPTION_FONT_COLOR=white
CAPTION_OUTLINE_COLOR=black
CAPTION_OUTLINE_WIDTH=2

# Cost Optimization
MAX_FRAMES_PER_VIDEO=60
ENABLE_FRAME_DEDUPLICATION=true
